    <!-- Application Controller Logic -->
    <script>
        function commandCenter() {
            return {
                apiKey: '',
                apiKeyInput: '',
                ws: null,
                wsStatus: 'disconnected', // disconnected | connecting | connected
                reconnectTimer: null,
                reconnectDelay: 2000,
                snapshotTimer: null,
                clockTimer: null,
                now: Date.now(),
                searchQuery: '',
                selectedStockId: 1,
                newsLoading: false,
                stocks: [
                    { id: 1, ticker: 'AAPL', name: 'Apple Inc.', price: 0, change: 0, changePercent: '0.00', previousClose: 0, high: 0, low: 0, open: 0, lastUpdate: null, flash: null, predictability: 'High', metrics: { volatility: 'Low-Mod', trend: 'Scanning', support: '0.00', resistance: '0.00' }, predictabilityNote: 'Connect your API key to load live telemetry for this asset.' },
                    { id: 2, ticker: 'MSFT', name: 'Microsoft Corporation', price: 0, change: 0, changePercent: '0.00', previousClose: 0, high: 0, low: 0, open: 0, lastUpdate: null, flash: null, predictability: 'High', metrics: { volatility: 'Low', trend: 'Scanning', support: '0.00', resistance: '0.00' }, predictabilityNote: 'Connect your API key to load live telemetry for this asset.' },
                    { id: 3, ticker: 'NVDA', name: 'NVIDIA Corporation', price: 0, change: 0, changePercent: '0.00', previousClose: 0, high: 0, low: 0, open: 0, lastUpdate: null, flash: null, predictability: 'Medium', metrics: { volatility: 'High', trend: 'Scanning', support: '0.00', resistance: '0.00' }, predictabilityNote: 'Connect your API key to load live telemetry for this asset.' }
                ],
                currentNewsList: [],

                // Pre-Market Hot List
                hotListThreshold: 5,
                hotListScanning: false,
                hotListProgress: 0,
                hotListResults: [],
                hotListLastScan: '',
                hotListAutoScan: false,
                hotListAutoTimer: null,
                hotListUniverse: [
                    'AAPL','MSFT','GOOGL','AMZN','META','NVDA','TSLA','AVGO','ORCL','CRM','ADBE','AMD','INTC','CSCO','QCOM','TXN','IBM','NOW','UBER','SHOP',
                    'MU','AMAT','LRCX','KLAC','ASML','TSM','ARM','SMCI','DELL','HPQ','PANW','CRWD','ZS','NET','DDOG','SNOW','PLTR','SOUN','BBAI','AI',
                    'JPM','BAC','WFC','C','GS','MS','SCHW','AXP','V','MA','PYPL','SQ','SOFI','AFRM','COIN','HOOD','MARA','RIOT','HUT','CLSK',
                    'XOM','CVX','OXY','DVN','SLB','HAL','COP','MPC','PSX','VLO',
                    'JNJ','PFE','UNH','LLY','MRK','ABBV','BMY','GILD','AMGN','VRTX','MRNA','NVAX','BNTX','SAVA','OCGN','INO','VXRT','CRSP','EDIT','NTLA','BEAM',
                    'WMT','TGT','COST','HD','LOW','NKE','SBUX','MCD','CMG','LULU','ROST','DG','DLTR',
                    'BA','CAT','GE','HON','LMT','RTX','DE','UPS','FDX','UNP',
                    'RIVN','LCID','NIO','XPEV','LI','FSR','CHPT','PLUG','FCEL','ENPH','SEDG','RUN','FSLR',
                    'GME','AMC','BB','TLRY','CGC','ACB','SNDL','RKLB','SPCE',
                    'AAL','UAL','DAL','LUV','CCL','RCL','NCLH',
                    'BABA','JD','PDD','BIDU','NFLX','DIS','WBD','PARA','ROKU',
                    'F','GM','TM','HMC','RIVN','ABNB','BKNG','EXPE',
                    'T','VZ','TMUS','CMCSA',
                    'PG','KO','PEP','MO','PM','CL','KMB',
                    'CVS','WBA','CI','HUM','ELV'
                ],

                init() {
                    const savedStocks = localStorage.getItem('command_center_real_stocks');
                    if (savedStocks) {
                        try {
                            const parsed = JSON.parse(savedStocks);
                            if (Array.isArray(parsed) && parsed.length > 0) {
                                this.stocks = parsed.map(s => ({
                                    previousClose: 0, high: 0, low: 0, open: 0, lastUpdate: null, flash: null,
                                    ...s
                                }));
                            }
                        } catch (e) {}
                    }
                    if (!this.stocks.some(s => s.id === this.selectedStockId)) {
                        this.selectedStockId = this.stocks[0].id;
                    }

                    // Live "updated Xs ago" ticker
                    this.clockTimer = setInterval(() => { this.now = Date.now(); }, 1000);

                    const savedKey = localStorage.getItem('finnhub_api_key');
                    if (savedKey) {
                        this.apiKey = savedKey;
                        this.connectAndLoad();
                    }
                },

                saveData() {
                    localStorage.setItem('command_center_real_stocks', JSON.stringify(
                        this.stocks.map(({ _prevTicker, ...rest }) => rest)
                    ));
                },

                saveApiKey() {
                    const key = this.apiKeyInput.trim();
                    if (!key) return;
                    this.apiKey = key;
                    localStorage.setItem('finnhub_api_key', key);
                    this.apiKeyInput = '';
                    this.connectAndLoad();
                },

                changeApiKey() {
                    this.disconnectWs();
                    clearInterval(this.snapshotTimer);
                    clearInterval(this.hotListAutoTimer);
                    this.apiKey = '';
                    localStorage.removeItem('finnhub_api_key');
                },

                async connectAndLoad() {
                    // De-dupe the scan universe in case of overlapping sector lists.
                    this.hotListUniverse = Array.from(new Set(this.hotListUniverse));

                    await Promise.all(this.stocks.map(s => this.fetchQuoteAndProfile(s)));
                    this.saveData();
                    this.fetchNewsFor(this.getActiveStock());
                    this.connectWebSocket();

                    // Safety-net REST refresh every 60s in addition to instant WS ticks,
                    // so session high/low/metrics stay accurate even between trades.
                    clearInterval(this.snapshotTimer);
                    this.snapshotTimer = setInterval(() => {
                        this.stocks.forEach(s => this.fetchQuoteAndProfile(s));
                    }, 60000);

                    // Hot List auto-scan check, every 10 min, only fires during pre-market.
                    clearInterval(this.hotListAutoTimer);
                    this.hotListAutoTimer = setInterval(() => {
                        if (this.hotListAutoScan && !this.hotListScanning && this.marketSession() === 'pre') {
                            this.runHotListScan();
                        }
                    }, 10 * 60000);
                },

                connectWebSocket() {
                    if (!this.apiKey) return;
                    this.wsStatus = 'connecting';
                    try {
                        this.ws = new WebSocket(`wss://ws.finnhub.io?token=${this.apiKey}`);
                    } catch (e) {
                        this.wsStatus = 'disconnected';
                        this.scheduleReconnect();
                        return;
                    }

                    this.ws.onopen = () => {
                        this.wsStatus = 'connected';
                        this.reconnectDelay = 2000;
                        this.stocks.forEach(s => this.subscribe(s.ticker));
                    };

                    this.ws.onmessage = (event) => {
                        try {
                            const msg = JSON.parse(event.data);
                            if (msg.type === 'trade' && Array.isArray(msg.data)) {
                                msg.data.forEach(trade => this.applyTrade(trade));
                            }
                        } catch (e) {}
                    };

                    this.ws.onerror = () => {};

                    this.ws.onclose = () => {
                        this.wsStatus = 'disconnected';
                        this.scheduleReconnect();
                    };
                },

                scheduleReconnect() {
                    if (!this.apiKey) return;
                    clearTimeout(this.reconnectTimer);
                    this.reconnectTimer = setTimeout(() => {
                        this.reconnectDelay = Math.min(this.reconnectDelay * 1.5, 30000);
                        this.connectWebSocket();
                    }, this.reconnectDelay);
                },

                disconnectWs() {
                    clearTimeout(this.reconnectTimer);
                    if (this.ws) {
                        this.ws.onclose = null;
                        this.ws.close();
                        this.ws = null;
                    }
                    this.wsStatus = 'disconnected';
                },

                subscribe(ticker) {
                    if (this.ws && this.ws.readyState === WebSocket.OPEN && ticker) {
                        this.ws.send(JSON.stringify({ type: 'subscribe', symbol: ticker.toUpperCase() }));
                    }
                },

                unsubscribe(ticker) {
                    if (this.ws && this.ws.readyState === WebSocket.OPEN && ticker) {
                        this.ws.send(JSON.stringify({ type: 'unsubscribe', symbol: ticker.toUpperCase() }));
                    }
                },

                applyTrade(trade) {
                    const stock = this.stocks.find(s => s.ticker && s.ticker.toUpperCase() === trade.s);
                    if (!stock) return;
                    const newPrice = trade.p;
                    const prevPrice = stock.price;

                    stock.price = Number(newPrice.toFixed(2));
                    if (stock.previousClose) {
                        const diff = newPrice - stock.previousClose;
                        stock.change = Number(diff.toFixed(2));
                        stock.changePercent = ((diff / stock.previousClose) * 100).toFixed(2);
                    }
                    if (!stock.high || newPrice > stock.high) stock.high = newPrice;
                    if (!stock.low || newPrice < stock.low) stock.low = newPrice;
                    stock.metrics.support = stock.low.toFixed(2);
                    stock.metrics.resistance = stock.high.toFixed(2);

                    stock.lastUpdate = Date.now();
                    stock.flash = newPrice > prevPrice ? 'up' : (newPrice < prevPrice ? 'down' : stock.flash);
                    clearTimeout(stock._flashTimer);
                    stock._flashTimer = setTimeout(() => { stock.flash = null; }, 900);

                    this.saveData();
                },

                async fetchQuoteAndProfile(stock) {
                    if (!stock.ticker || !this.apiKey) return;
                    const ticker = stock.ticker.trim().toUpperCase();
                    try {
                        const [quoteRes, profileRes] = await Promise.all([
                            fetch(`https://finnhub.io/api/v1/quote?symbol=${ticker}&token=${this.apiKey}`),
                            fetch(`https://finnhub.io/api/v1/stock/profile2?symbol=${ticker}&token=${this.apiKey}`)
                        ]);
                        const quote = await quoteRes.json();
                        const profile = await profileRes.json();

                        if (quote && (quote.c || quote.pc)) {
                            stock.price = Number((quote.c || 0).toFixed(2));
                            stock.previousClose = quote.pc || 0;
                            stock.high = quote.h || stock.price;
                            stock.low = quote.l || stock.price;
                            stock.open = quote.o || stock.price;

                            const diff = quote.d != null ? quote.d : (stock.price - stock.previousClose);
                            stock.change = Number((diff || 0).toFixed(2));
                            stock.changePercent = quote.dp != null
                                ? quote.dp.toFixed(2)
                                : (stock.previousClose ? ((diff / stock.previousClose) * 100).toFixed(2) : '0.00');

                            stock.metrics.support = (stock.low || stock.price).toFixed(2);
                            stock.metrics.resistance = (stock.high || stock.price).toFixed(2);

                            const rangePct = stock.price ? (((stock.high - stock.low) / stock.price) * 100) : 0;
                            stock.metrics.volatility = rangePct > 4 ? 'High' : (rangePct > 1.5 ? 'Moderate' : 'Low');
                            stock.metrics.trend = stock.price >= stock.open ? 'Above Open' : 'Below Open';
                            stock.predictabilityNote = `Session range: $${stock.low.toFixed(2)} – $${stock.high.toFixed(2)} (${rangePct.toFixed(1)}% spread). Currently trading ${stock.metrics.trend === 'Above Open' ? 'above' : 'below'} today's open of $${stock.open.toFixed(2)}.`;

                            stock.lastUpdate = Date.now();
                        }
                        if (profile && profile.name) {
                            stock.name = profile.name;
                        }
                    } catch (err) {
                        console.warn(`Live pull failed for ${ticker}:`, err);
                    }
                },

                manualRefresh() {
                    this.stocks.forEach(s => this.fetchQuoteAndProfile(s));
                    this.saveData();
                },

                // Scans hotListUniverse in batches to respect Finnhub's free-tier
                // rate limit (60 calls/min), flagging anything moved >= hotListThreshold%
                // vs. its previous close. Only reflects tickers with an actual trade print.
                async runHotListScan() {
                    if (!this.apiKey || this.hotListScanning) return;
                    this.hotListScanning = true;
                    this.hotListProgress = 0;
                    const hits = [];
                    const batchSize = 55; // leave headroom under the 60/min cap
                    const universe = this.hotListUniverse;

                    for (let i = 0; i < universe.length; i += batchSize) {
                        const batch = universe.slice(i, i + batchSize);
                        const results = await Promise.all(batch.map(async (sym) => {
                            try {
                                const res = await fetch(`https://finnhub.io/api/v1/quote?symbol=${sym}&token=${this.apiKey}`);
                                const q = await res.json();
                                if (q && q.pc) {
                                    const changePct = ((q.c - q.pc) / q.pc) * 100;
                                    return { ticker: sym, price: q.c, changePercent: changePct.toFixed(2), raw: changePct };
                                }
                            } catch (e) {}
                            return null;
                        }));

                        results.forEach(r => {
                            if (r && r.raw >= this.hotListThreshold) hits.push(r);
                        });

                        this.hotListProgress = Math.min(i + batchSize, universe.length);

                        if (i + batchSize < universe.length) {
                            await new Promise(resolve => setTimeout(resolve, 61000));
                        }
                    }

                    hits.sort((a, b) => b.raw - a.raw);
                    this.hotListResults = hits;
                    this.hotListLastScan = new Date().toLocaleTimeString();
                    this.hotListScanning = false;
                },

                addFromHotList(hit) {
                    if (this.stocks.some(s => s.ticker.toUpperCase() === hit.ticker)) {
                        alert(`${hit.ticker} is already tracked.`);
                        return;
                    }
                    const newId = Date.now();
                    const newStock = {
                        id: newId,
                        ticker: hit.ticker,
                        name: `${hit.ticker} Equity`,
                        price: 0, change: 0, changePercent: '0.00',
                        previousClose: 0, high: 0, low: 0, open: 0, lastUpdate: null, flash: null,
                        predictability: 'Medium',
                        metrics: { volatility: 'High', trend: 'Scanning', support: '0.00', resistance: '0.00' },
                        predictabilityNote: `Added from the Hot List after a +${hit.changePercent}% move.`
                    };
                    this.stocks.push(newStock);
                    this.selectedStockId = newId;
                    this.saveData();
                    this.fetchQuoteAndProfile(newStock).then(() => {
                        this.subscribe(hit.ticker);
                        this.saveData();
                    });
                },

                async searchAndAddTicker() {
                    const sym = this.searchQuery.trim().toUpperCase();
                    if (!sym) return;
                    if (!this.apiKey) {
                        alert('Connect your free Finnhub API key first.');
                        return;
                    }
                    if (this.stocks.some(s => s.ticker.toUpperCase() === sym)) {
                        alert(`Ticker ${sym} is already in your command center.`);
                        this.searchQuery = '';
                        return;
                    }

                    try {
                        const res = await fetch(`https://finnhub.io/api/v1/quote?symbol=${sym}&token=${this.apiKey}`);
                        const data = await res.json();
                        if (!data || (data.c === 0 && data.pc === 0)) {
                            alert(`Could not find ticker ${sym}.`);
                            return;
                        }
                    } catch (e) {
                        alert('Could not reach Finnhub. Check your connection or API key.');
                        return;
                    }

                    const newId = Date.now();
                    const newStock = {
                        id: newId,
                        ticker: sym,
                        name: `${sym} Equity`,
                        price: 0, change: 0, changePercent: '0.00',
                        previousClose: 0, high: 0, low: 0, open: 0, lastUpdate: null, flash: null,
                        predictability: 'Medium',
                        metrics: { volatility: 'Moderate', trend: 'Scanning', support: '0.00', resistance: '0.00' },
                        predictabilityNote: `Live telemetry initializing for ${sym}.`
                    };

                    this.stocks.push(newStock);
                    this.selectedStockId = newId;
                    this.searchQuery = '';
                    this.saveData();

                    await this.fetchQuoteAndProfile(newStock);
                    this.subscribe(sym);
                    this.fetchNewsFor(newStock);
                    this.saveData();
                },

                removeStock(index) {
                    if (this.stocks.length <= 1) {
                        alert('You must keep at least one active ticker in your command center.');
                        return;
                    }
                    const [removed] = this.stocks.splice(index, 1);
                    this.unsubscribe(removed.ticker);
                    this.selectedStockId = this.stocks[0].id;
                    this.fetchNewsFor(this.stocks[0]);
                    this.saveData();
                },

                saveAndFetchSingle(stock, oldTicker) {
                    if (oldTicker && oldTicker !== stock.ticker) this.unsubscribe(oldTicker);
                    this.saveData();
                    this.fetchQuoteAndProfile(stock).then(() => {
                        this.subscribe(stock.ticker);
                        this.saveData();
                    });
                },

                getActiveStock() {
                    return this.stocks.find(s => s.id === this.selectedStockId) || this.stocks[0];
                },

                async fetchNewsFor(stock) {
                    const t = stock && stock.ticker ? stock.ticker.toUpperCase() : '';
                    this.currentNewsList = [];
                    if (!t || !this.apiKey) return;

                    this.newsLoading = true;
                    try {
                        const to = new Date();
                        const from = new Date();
                        from.setDate(to.getDate() - 5);
                        const fmt = (d) => d.toISOString().split('T')[0];

                        const res = await fetch(`https://finnhub.io/api/v1/company-news?symbol=${t}&from=${fmt(from)}&to=${fmt(to)}&token=${this.apiKey}`);
                        const data = await res.json();
                        if (Array.isArray(data)) {
                            this.currentNewsList = data.slice(0, 6).map(n => ({
                                id: n.id,
                                source: n.source || 'News',
                                time: this.timeAgo(n.datetime),
                                title: n.headline,
                                snippet: n.summary,
                                url: n.url
                            }));
                        }
                    } catch (e) {
                        console.warn('News fetch failed', e);
                    } finally {
                        this.newsLoading = false;
                    }
                },

                timeAgo(unixSeconds) {
                    if (!unixSeconds) return '';
                    const diffMs = Date.now() - unixSeconds * 1000;
                    const mins = Math.floor(diffMs / 60000);
                    if (mins < 60) return `${mins}m ago`;
                    const hrs = Math.floor(mins / 60);
                    if (hrs < 24) return `${hrs}h ago`;
                    return `${Math.floor(hrs / 24)}d ago`;
                },

                formatMoney(val) {
                    return Number(val || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                },

                // Returns 'pre' | 'regular' | 'after' | 'closed' based on real US Eastern Time.
                // Reads this.now (ticked every second) so it stays reactive in the template.
                marketSession() {
                    const parts = new Intl.DateTimeFormat('en-US', {
                        timeZone: 'America/New_York',
                        hour12: false,
                        weekday: 'short',
                        hour: '2-digit',
                        minute: '2-digit'
                    }).formatToParts(new Date(this.now));

                    const map = {};
                    parts.forEach(p => { map[p.type] = p.value; });
                    if (map.weekday === 'Sat' || map.weekday === 'Sun') return 'closed';

                    const minutesSinceMidnight = parseInt(map.hour, 10) * 60 + parseInt(map.minute, 10);
                    const preStart = 4 * 60;          // 4:00 AM ET
                    const regularStart = 9 * 60 + 30; // 9:30 AM ET
                    const regularEnd = 16 * 60;        // 4:00 PM ET
                    const afterEnd = 20 * 60;          // 8:00 PM ET

                    if (minutesSinceMidnight >= preStart && minutesSinceMidnight < regularStart) return 'pre';
                    if (minutesSinceMidnight >= regularStart && minutesSinceMidnight < regularEnd) return 'regular';
                    if (minutesSinceMidnight >= regularEnd && minutesSinceMidnight < afterEnd) return 'after';
                    return 'closed';
                },

                sessionLabel() {
                    const s = this.marketSession();
                    return s === 'pre' ? 'Pre-Market' : s === 'after' ? 'After-Hours' : s === 'closed' ? 'Market Closed' : 'Market Open';
                },

                sessionColorClass() {
                    const s = this.marketSession();
                    if (s === 'pre') return 'bg-amber-950 text-amber-400 border border-amber-900';
                    if (s === 'after') return 'bg-blue-950 text-blue-400 border border-blue-900';
                    if (s === 'closed') return 'bg-slate-900 text-slate-500 border border-slate-800';
                    return 'bg-emerald-950 text-emerald-400 border border-emerald-900';
                }
            }
        }

        function investmentTracker() {
