                    { id: 2, category: 'Aggressive Growth', name: 'Fidelity Advisor Energy Fund', mine: 327.19, employer: 83.67 },
                    { id: 3, category: 'Aggressive Growth', name: 'Fidelity NASDAQ Composite Idx', mine: 1413.12, employer: 318.93 },
                    { id: 4, category: 'Aggressive Growth', name: 'JPMorgan Large Cap Growth', mine: 621.02, employer: 134.28 },
                    { id: 5, category: 'Aggressive Growth', name: 'Nuveen Large-Cap Growth Index', mine: 426.58, employer: 92.77 },
                    { id: 6, category: 'Aggressive Growth', name: 'Science & Technology Fund', mine: 945.29, employer: 246.73 },
                    { id: 7, category: 'Aggressive Growth', name: 'Vanguard Mid-Cap Growth ETF', mine: 223.65, employer: 48.86 },
                    { id: 8, category: 'Aggressive Growth', name: 'Vanguard Small Cap Grow Index', mine: 247.79, employer: 56.72 },
                    { id: 9, category: 'Growth', name: '500 Index Fund', mine: 467.92, employer: 105.16 }
                ],

                init() {
                    const saved = localStorage.getItem('investment_portfolio');
                    if (saved) {
                        try {
                            const parsed = JSON.parse(saved);
                            if (Array.isArray(parsed) && parsed.length > 0) this.funds = parsed;
                        } catch (e) {}
                    }

                    // Seed target allocation % from the current dollar ratio, for any fund
                    // that doesn't already have a target set (e.g. first run, or a newly added fund).
                    const totalMineNow = this.funds.reduce((s, f) => s + f.mine, 0);
                    const totalEmployerNow = this.funds.reduce((s, f) => s + f.employer, 0);
                    this.funds.forEach(f => {
                        if (f.mineTargetPct === undefined) {
                            f.mineTargetPct = totalMineNow > 0 ? Number(((f.mine / totalMineNow) * 100).toFixed(2)) : 0;
                        }
                        if (f.employerTargetPct === undefined) {
                            f.employerTargetPct = totalEmployerNow > 0 ? Number(((f.employer / totalEmployerNow) * 100).toFixed(2)) : 0;
                        }
                    });
                    this.saveData();
                },

                saveData() {
                    localStorage.setItem('investment_portfolio', JSON.stringify(this.funds));
                },

                fundsIn(catName) {
                    return this.funds.filter(f => f.category === catName);
                },

                totalMine() { return this.funds.reduce((s, f) => s + f.mine, 0); },
                totalEmployer() { return this.funds.reduce((s, f) => s + f.employer, 0); },
                totalAll() { return this.totalMine() + this.totalEmployer(); },

                categoryTotal(catName) {
                    return this.fundsIn(catName).reduce((s, f) => s + f.mine + f.employer, 0);
                },
                categoryPct(catName) {
                    const total = this.totalAll();
                    return total ? (this.categoryTotal(catName) / total * 100) : 0;
                },
                pctOfTotal(fund) {
                    const total = this.totalAll();
                    return total ? ((fund.mine + fund.employer) / total * 100) : 0;
                },

                mineTargetSum() { return this.funds.reduce((s, f) => s + (f.mineTargetPct || 0), 0); },
                employerTargetSum() { return this.funds.reduce((s, f) => s + (f.employerTargetPct || 0), 0); },

                addContribution() {
                    const mineAmt = Number(this.newMine) || 0;
                    const employerAmt = Number(this.newEmployer) || 0;
                    if (mineAmt <= 0 && employerAmt <= 0) {
                        alert('Enter an amount to contribute.');
                        return;
                    }

                    const mineSum = this.mineTargetSum();
                    const employerSum = this.employerTargetSum();

                    if (mineAmt > 0 && Math.abs(mineSum - 100) > 0.5) {
                        if (!confirm(`Your target allocation adds up to ${mineSum.toFixed(1)}%, not 100%. Continue anyway? Funds will be split proportionally to whatever you've set.`)) return;
                    }
                    if (employerAmt > 0 && Math.abs(employerSum - 100) > 0.5) {
                        if (!confirm(`Your employer target allocation adds up to ${employerSum.toFixed(1)}%, not 100%. Continue anyway?`)) return;
                    }

                    let fundsTouched = 0;
                    this.funds.forEach(f => {
                        let touched = false;
                        if (mineAmt > 0 && mineSum > 0 && f.mineTargetPct > 0) {
                            f.mine = Number((f.mine + mineAmt * (f.mineTargetPct / mineSum)).toFixed(2));
                            touched = true;
                        }
                        if (employerAmt > 0 && employerSum > 0 && f.employerTargetPct > 0) {
                            f.employer = Number((f.employer + employerAmt * (f.employerTargetPct / employerSum)).toFixed(2));
                            touched = true;
                        }
                        if (touched) fundsTouched++;
                    });

                    this.saveData();
                    this.lastAllocationNote = `Added $${(mineAmt + employerAmt).toFixed(2)} across ${fundsTouched} fund${fundsTouched === 1 ? '' : 's'}.`;
                    this.newMine = null;
                    this.newEmployer = null;
                    setTimeout(() => { this.lastAllocationNote = ''; }, 6000);
                },

                formatMoney(val) {
                    return Number(val || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                }
            }
        }
    </script>
