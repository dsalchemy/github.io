<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Live Stock Command Center</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Alpine.js CDN -->
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen font-sans p-4 md:p-6" x-data="commandCenter()" x-init="init()">

    <div class="max-w-7xl mx-auto space-y-6">

        <!-- Header & Status Bar -->
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center border-b border-slate-800 pb-4 gap-4">
            <div>
                <h1 class="text-2xl font-bold tracking-tight text-white flex items-center gap-2">
                    <span>⚡</span> Live Stock Command Center
                </h1>
                <p class="text-xs text-slate-400 mt-1 flex items-center gap-2 flex-wrap">
                    <span class="flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full"
                              :class="wsStatus === 'connected' ? 'bg-emerald-400 animate-pulse' : (wsStatus === 'connecting' ? 'bg-amber-400 animate-pulse' : 'bg-rose-500')"></span>
                        <span class="font-semibold"
                              :class="wsStatus === 'connected' ? 'text-emerald-400' : (wsStatus === 'connecting' ? 'text-amber-400' : 'text-rose-400')"
                              x-text="wsStatus === 'connected' ? 'Live — streaming trades' : (wsStatus === 'connecting' ? 'Connecting…' : (apiKey ? 'Disconnected — reconnecting…' : 'Not connected'))"></span>
                    </span>
                    <span class="text-[10px] font-bold uppercase px-2 py-0.5 rounded-full"
                          :class="sessionColorClass()"
                          x-text="sessionLabel()"></span>
                    <template x-if="apiKey">
                        <span class="text-slate-500 flex items-center gap-2">
                            <span class="text-slate-700">|</span>
                            Finnhub real-time feed
                        </span>
                    </template>
                </p>
                <p class="text-[10px] text-slate-600 mt-1" x-show="apiKey && marketSession() !== 'regular'">
                    Trade prints outside 9:30am–4pm ET are sparse on the free real-time feed — prices may lag or hold at the last print.
                </p>
            </div>
            <div class="flex items-center gap-2">
                <template x-if="!apiKey">
                    <div class="flex flex-col items-end gap-1">
                        <div class="flex items-center gap-2">
                            <input
                                type="password"
                                x-model="apiKeyInput"
                                @keydown.enter="saveApiKey()"
                                placeholder="Paste your free Finnhub API key…"
                                class="bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-xs text-slate-200 focus:outline-none focus:border-emerald-500 w-64"
                            >
                            <button
                                @click="saveApiKey()"
                                class="bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold px-4 py-2 rounded-lg transition shadow-lg shadow-emerald-950/55 whitespace-nowrap"
                            >
                                Connect
                            </button>
                        </div>
                        <a href="https://finnhub.io/register" target="_blank" class="text-[10px] text-slate-500 hover:text-emerald-400 underline">Get a free key at finnhub.io/register</a>
                    </div>
                </template>
                <template x-if="apiKey">
                    <div class="flex items-center gap-2">
                        <button
                            @click="manualRefresh()"
                            class="bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold px-4 py-2 rounded-lg transition shadow-lg shadow-emerald-950/55 flex items-center gap-1.5"
                        >
                            <span>🔄</span> Refresh Snapshot
                        </button>
                        <button
                            @click="changeApiKey()"
                            class="text-slate-500 hover:text-rose-400 text-xs font-medium px-3 py-2 border border-slate-800 rounded-lg"
                            title="Disconnect and change key"
                        >
                            Disconnect
                        </button>
                    </div>
                </template>
            </div>
        </div>

        <!-- Pre-Market Hot List -->
        <div class="bg-slate-900 rounded-xl border border-orange-900/40 p-6 space-y-4">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-3">
                <div>
                    <h2 class="text-sm font-bold text-white flex items-center gap-2"><span>🔥</span> Pre-Market Hot List</h2>
                    <p class="text-xs text-slate-400 mt-1 max-w-xl">
                        Scans a curated universe of <span x-text="hotListUniverse.length"></span> liquid & historically volatile tickers for moves of
                        <span class="text-orange-400 font-semibold" x-text="hotListThreshold + '%+'"></span> vs. last close.
                        Free-tier rate limits mean a full pass takes a few minutes and only reflects tickers where a trade has actually printed.
                        This isn't literally every stock on the market — for full-market coverage you'd need a paid screener feed.
                    </p>
                </div>
                <div class="flex items-center gap-2 flex-wrap justify-end">
                    <select x-model.number="hotListThreshold" class="bg-slate-950 border border-slate-700 rounded-lg px-2 py-2 text-xs text-slate-200 focus:outline-none focus:border-orange-500">
                        <option :value="5">5%+</option>
                        <option :value="10">10%+</option>
                        <option :value="15">15%+</option>
                        <option :value="20">20%+</option>
                    </select>
                    <button
                        @click="runHotListScan()"
                        :disabled="hotListScanning || !apiKey"
                        class="bg-orange-600 hover:bg-orange-500 disabled:opacity-40 disabled:cursor-not-allowed text-white text-xs font-semibold px-4 py-2 rounded-lg transition whitespace-nowrap"
                        x-text="hotListScanning ? '⏳ Scanning…' : '🔍 Scan Now'"
                    ></button>
                </div>
            </div>

            <label class="flex items-center gap-1.5 text-[10px] text-slate-400" x-show="apiKey">
                <input type="checkbox" x-model="hotListAutoScan" class="accent-orange-500">
                Auto-scan every 10 min while pre-market is active
            </label>

            <div x-show="hotListScanning" class="space-y-1">
                <p class="text-[11px] text-slate-500">Scanning <span x-text="hotListProgress"></span> / <span x-text="hotListUniverse.length"></span> tickers…</p>
                <div class="w-full bg-slate-800 h-1.5 rounded-full overflow-hidden">
                    <div class="bg-orange-500 h-full transition-all duration-500" :style="'width: ' + (hotListProgress / hotListUniverse.length * 100) + '%'"></div>
                </div>
            </div>

            <template x-if="!apiKey">
                <p class="text-xs text-slate-500">Connect your Finnhub API key above to scan for movers.</p>
            </template>

            <template x-if="apiKey && !hotListScanning && hotListResults.length === 0 && hotListLastScan">
                <p class="text-xs text-slate-500">No tickers in the scan universe moved <span x-text="hotListThreshold"></span>%+ as of the last scan.</p>
            </template>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3" x-show="hotListResults.length > 0">
                <template x-for="hit in hotListResults" :key="hit.ticker">
                    <div class="bg-slate-950 border border-orange-900/50 rounded-lg p-3 flex items-center justify-between gap-2">
                        <p class="text-xs font-mono font-bold text-orange-400" x-text="hit.ticker"></p>
                        <div class="text-right">
                            <p class="text-sm font-bold text-white font-mono" x-text="'$' + formatMoney(hit.price)"></p>
                            <p class="text-xs font-bold text-emerald-400" x-text="'+' + hit.changePercent + '%'"></p>
                        </div>
                        <button @click="addFromHotList(hit)" class="text-[10px] bg-slate-800 hover:bg-emerald-700 text-slate-300 hover:text-white px-2 py-1 rounded whitespace-nowrap" title="Add to tracked list">+ Track</button>
                    </div>
                </template>
            </div>

            <p class="text-[10px] text-slate-600" x-show="hotListLastScan" x-text="'Last scanned: ' + hotListLastScan"></p>
        </div>

        <!-- Dynamic Stock Cards Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3">
            <template x-for="stock in stocks" :key="stock.id">
                <div @click="selectedStockId = stock.id; fetchNewsFor(stock)"
                     class="bg-slate-900 p-4 rounded-xl border transition-all cursor-pointer shadow-sm relative overflow-hidden group"
                     :class="selectedStockId === stock.id ? 'border-emerald-500 ring-1 ring-emerald-500/50 bg-slate-900/90' : 'border-slate-800 hover:border-slate-700'">

                    <div class="flex justify-between items-center">
                        <span class="text-xs font-mono font-bold text-emerald-400 px-1.5 py-0.5 bg-slate-950 rounded border border-slate-800" x-text="stock.ticker ? stock.ticker.toUpperCase() : '---'"></span>
                        <span class="text-[10px] uppercase tracking-wider font-semibold"
                              :class="stock.change >= 0 ? 'text-emerald-400' : 'text-rose-400'"
                              x-text="(stock.change >= 0 ? '+' : '') + stock.changePercent + '%'"></span>
                    </div>

                    <p class="text-lg font-extrabold text-white mt-2 font-mono transition-colors duration-700 rounded px-1 -mx-1"
                       :class="stock.flash === 'up' ? 'bg-emerald-500/20' : (stock.flash === 'down' ? 'bg-rose-500/20' : '')"
                       x-text="stock.price > 0 ? '$' + formatMoney(stock.price) : (apiKey ? 'Loading…' : '—')"></p>
                    <p class="text-[11px] text-slate-400 truncate mt-0.5" x-text="stock.name || 'Unnamed Asset'"></p>
                    <div class="flex items-center gap-1.5 mt-1 h-3">
                        <p class="text-[9px] text-slate-600" x-show="stock.lastUpdate" x-text="'Updated ' + Math.max(0, Math.round((now - stock.lastUpdate)/1000)) + 's ago'"></p>
                        <span class="text-[8px] font-bold uppercase px-1 rounded" x-show="marketSession() !== 'regular'" :class="sessionColorClass()" x-text="sessionLabel()"></span>
                    </div>

                    <div class="mt-2 pt-2 border-t border-slate-800/80 flex justify-between items-center text-[10px]">
                        <span class="text-slate-400">Predictability:</span>
                        <span class="font-bold uppercase"
                              :class="stock.predictability === 'High' ? 'text-emerald-400' : (stock.predictability === 'Medium' ? 'text-amber-400' : 'text-rose-400')"
                              x-text="stock.predictability"></span>
                    </div>
                </div>
            </template>
        </div>

        <!-- Detailed Workspace: Selected Stock Focus -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

            <!-- Left 2 Columns: Stock Deep-Dive, Metrics & Search Manager -->
            <div class="lg:col-span-2 space-y-6">

                <!-- Main Asset Control Card -->
                <div class="bg-slate-900 rounded-xl border border-slate-800 p-6 space-y-4">
                    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-2 border-b border-slate-800 pb-4">
                        <div>
                            <div class="flex items-center gap-2">
                                <h2 class="text-lg font-bold text-white" x-text="getActiveStock().name"></h2>
                                <span class="text-xs font-mono bg-emerald-950 text-emerald-400 px-2 py-0.5 rounded border border-emerald-900" x-text="getActiveStock().ticker.toUpperCase()"></span>
                            </div>
                            <p class="text-xs text-slate-400 mt-0.5">Live Market Feed & Behavioral Analysis</p>
                        </div>
                        <div class="text-right">
                            <p class="text-2xl font-extrabold font-mono text-white transition-colors duration-700 rounded px-1 -mx-1"
                               :class="getActiveStock().flash === 'up' ? 'bg-emerald-500/20' : (getActiveStock().flash === 'down' ? 'bg-rose-500/20' : '')"
                               x-text="getActiveStock().price > 0 ? '$' + formatMoney(getActiveStock().price) : '$0.00'"></p>
                            <p class="text-xs font-medium"
                               :class="getActiveStock().change >= 0 ? 'text-emerald-400' : 'text-rose-400'"
                               x-text="(getActiveStock().change >= 0 ? '+' : '') + formatMoney(getActiveStock().change) + ' (' + getActiveStock().changePercent + '%)'"></p>
                            <span class="inline-block text-[9px] font-bold uppercase px-1.5 py-0.5 rounded mt-1" x-show="marketSession() !== 'regular'" :class="sessionColorClass()" x-text="sessionLabel() + ' vs. last close'"></span>
                        </div>
                    </div>

                    <!-- Technical Metrics Matrix -->
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
                        <div class="bg-slate-950 p-3 rounded-lg border border-slate-800">
                            <p class="text-[10px] text-slate-400 uppercase">Trend Alignment</p>
                            <p class="text-sm font-bold text-slate-200 mt-1" x-text="getActiveStock().metrics.trend"></p>
                        </div>
                        <div class="bg-slate-950 p-3 rounded-lg border border-slate-800">
                            <p class="text-[10px] text-slate-400 uppercase">Volatility Index</p>
                            <p class="text-sm font-bold text-amber-400 mt-1" x-text="getActiveStock().metrics.volatility"></p>
                        </div>
                        <div class="bg-slate-950 p-3 rounded-lg border border-slate-800">
                            <p class="text-[10px] text-slate-400 uppercase">Session Low</p>
                            <p class="text-sm font-bold text-emerald-400 mt-1" x-text="'$' + getActiveStock().metrics.support"></p>
                        </div>
                        <div class="bg-slate-950 p-3 rounded-lg border border-slate-800">
                            <p class="text-[10px] text-slate-400 uppercase">Session High</p>
                            <p class="text-sm font-bold text-rose-400 mt-1" x-text="'$' + getActiveStock().metrics.resistance"></p>
                        </div>
                    </div>

                    <!-- Predictability Breakdown -->
                    <div class="bg-slate-950/80 p-4 rounded-lg border border-slate-800 space-y-2">
                        <p class="text-xs font-semibold text-emerald-400 flex items-center gap-1.5">
                            <span>🧠</span> Predictability Synthesis & Probability Analysis
                        </p>
                        <p class="text-xs text-slate-300 leading-relaxed" x-text="getActiveStock().predictabilityNote"></p>
                    </div>
                </div>

                <!-- Ticker Search Box & Asset Manager -->
                <div class="bg-slate-900 rounded-xl border border-slate-800 p-6 space-y-4">
                    <div>
                        <h3 class="text-sm font-semibold text-white">Search & Add New Ticker</h3>
                        <p class="text-xs text-slate-400">Type any stock symbol below to subscribe to its live trade feed.</p>
                    </div>

                    <!-- Search Input Bar -->
                    <div class="flex gap-2 bg-slate-950 p-3 rounded-lg border border-slate-800">
                        <div class="flex-1">
                            <input
                                type="text"
                                x-model="searchQuery"
                                @keydown.enter="searchAndAddTicker()"
                                placeholder="Type Ticker Symbol (e.g. AMZN, META, GOOGL, NFLX)..."
                                class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm text-emerald-400 font-mono font-bold uppercase focus:outline-none focus:border-emerald-500 placeholder:text-slate-600 placeholder:font-normal placeholder:normal-case"
                            >
                        </div>
                        <button
                            @click="searchAndAddTicker()"
                            class="bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold px-5 py-2 rounded-lg transition shadow-md shadow-emerald-950/50 flex items-center gap-1.5 whitespace-nowrap"
                        >
                            <span>🔍</span> Search & Add
                        </button>
                    </div>

                    <!-- Existing Tracked Tickers List -->
                    <div class="pt-2 border-t border-slate-800 space-y-2.5">
                        <p class="text-xs font-medium text-slate-400 uppercase tracking-wider">Currently Tracked Assets</p>
                        <template x-for="(stock, index) in stocks" :key="stock.id">
                            <div class="flex items-center gap-3 bg-slate-950 p-3 rounded-lg border border-slate-800">
                                <div class="w-24">
                                    <label class="text-[9px] text-slate-500 uppercase block">Ticker</label>
                                    <input type="text" x-model="stock.ticker" @focus="stock._prevTicker = stock.ticker" @change="saveAndFetchSingle(stock, stock._prevTicker)" class="w-full bg-slate-900 border border-slate-700 rounded px-2 py-1 text-xs text-emerald-400 font-mono font-bold uppercase focus:outline-none focus:border-emerald-500">
                                </div>
                                <div class="flex-1">
                                    <label class="text-[9px] text-slate-500 uppercase block">Asset Name</label>
                                    <input type="text" x-model="stock.name" @change="saveData()" class="w-full bg-slate-900 border border-slate-700 rounded px-2 py-1 text-xs text-slate-200 focus:outline-none focus:border-emerald-500">
                                </div>
                                <div class="w-32">
                                    <label class="text-[9px] text-slate-500 uppercase block">Predictability</label>
                                    <select x-model="stock.predictability" @change="saveData()" class="w-full bg-slate-900 border border-slate-700 rounded px-2 py-1 text-xs text-slate-200 focus:outline-none focus:border-emerald-500">
                                        <option value="High">High</option>
                                        <option value="Medium">Medium</option>
                                        <option value="Low">Low</option>
                                    </select>
                                </div>
                                <div class="pt-3">
                                    <button @click="removeStock(index)" class="text-slate-500 hover:text-rose-400 font-bold px-2 py-1 text-base" title="Remove Ticker">×</button>
                                </div>
                            </div>
                        </template>
                    </div>
                </div>

            </div>

            <!-- Right Column: Live News Stream for Selected Stock -->
            <div class="bg-slate-900 rounded-xl border border-slate-800 p-6 flex flex-col h-full space-y-4">
                <div class="flex justify-between items-center border-b border-slate-800 pb-3">
                    <div>
                        <h3 class="text-sm font-bold text-white flex items-center gap-2">
                            <span>📰</span> Live News Stream
                        </h3>
                        <p class="text-[11px] text-slate-400" x-text="'Recent headlines for ' + getActiveStock().ticker.toUpperCase()"></p>
                    </div>
                    <span class="text-[10px] bg-slate-950 text-emerald-400 px-2 py-0.5 rounded border border-slate-800 font-mono" x-text="getActiveStock().ticker.toUpperCase()"></span>
                </div>

                <!-- News Feed Item List -->
                <div class="space-y-3 overflow-y-auto max-h-[520px] pr-1">
                    <template x-if="!apiKey">
                        <p class="text-xs text-slate-500 py-6 text-center">Connect your API key to load real headlines.</p>
                    </template>
                    <template x-if="apiKey && newsLoading">
                        <p class="text-xs text-slate-500 py-6 text-center">Loading headlines…</p>
                    </template>
                    <template x-if="apiKey && !newsLoading && currentNewsList.length === 0">
                        <p class="text-xs text-slate-500 py-6 text-center">No recent headlines found for this ticker.</p>
                    </template>
                    <template x-for="news in currentNewsList" :key="news.id">
                        <div class="bg-slate-950 p-3.5 rounded-lg border border-slate-800/80 hover:border-slate-700 transition space-y-1.5">
                            <div class="flex justify-between items-center text-[10px] text-slate-500">
                                <span class="text-emerald-400 font-semibold" x-text="news.source"></span>
                                <span x-text="news.time"></span>
                            </div>
                            <h4 class="text-xs font-semibold text-slate-200 leading-snug" x-text="news.title"></h4>
                            <p class="text-[11px] text-slate-400 leading-normal" x-text="news.snippet"></p>
                            <div class="flex justify-end items-center pt-1">
                                <a :href="news.url" target="_blank" rel="noopener" class="text-[10px] text-emerald-400 hover:underline">Read Full Story →</a>
                            </div>
                        </div>
                    </template>
                </div>
            </div>

        </div>

    </div>

    <!-- Investments: 401(k)/Retirement Contribution Tracker -->
    <div class="max-w-7xl mx-auto space-y-6 mt-10" x-data="investmentTracker()" x-init="init()">

        <div class="border-b border-slate-800 pb-4">
            <h1 class="text-2xl font-bold tracking-tight text-white flex items-center gap-2">
                <span>💼</span> Investments
            </h1>
            <p class="text-xs text-slate-400 mt-0.5">Retirement Account Contributions & Allocation</p>
        </div>

        <!-- Summary Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div class="bg-slate-900 rounded-xl border border-slate-800 p-4">
                <p class="text-[10px] text-slate-400 uppercase">My Contributions</p>
                <p class="text-xl font-extrabold font-mono text-white mt-1" x-text="'$' + formatMoney(totalMine())"></p>
            </div>
            <div class="bg-slate-900 rounded-xl border border-slate-800 p-4">
                <p class="text-[10px] text-slate-400 uppercase">Employer Contributions</p>
                <p class="text-xl font-extrabold font-mono text-white mt-1" x-text="'$' + formatMoney(totalEmployer())"></p>
            </div>
            <div class="bg-slate-900 rounded-xl border border-slate-800 p-4">
                <p class="text-[10px] text-slate-400 uppercase">Total Account Value</p>
                <p class="text-xl font-extrabold font-mono text-emerald-400 mt-1" x-text="'$' + formatMoney(totalAll())"></p>
            </div>
        </div>

        <!-- Add Contribution Card -->
        <div class="bg-slate-900 rounded-xl border border-slate-800 p-6 space-y-4">
            <div class="flex justify-between items-start flex-wrap gap-2">
                <div>
                    <h3 class="text-sm font-semibold text-white">Add a New Contribution</h3>
                    <p class="text-xs text-slate-400">Enter what came out of your paycheck (and any employer match) — it's split across your funds automatically using the target allocation below.</p>
                </div>
                <button @click="editingAllocation = !editingAllocation" class="text-xs text-slate-400 hover:text-emerald-400 border border-slate-800 rounded-lg px-3 py-1.5 whitespace-nowrap" x-text="editingAllocation ? 'Done Editing' : 'Edit Target Allocation'"></button>
            </div>

            <div class="flex flex-wrap items-end gap-3 bg-slate-950 p-4 rounded-lg border border-slate-800">
                <div>
                    <label class="text-[10px] text-slate-500 uppercase block mb-1">Your Contribution</label>
                    <input type="number" step="0.01" min="0" x-model.number="newMine" placeholder="0.00" class="bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm text-emerald-400 font-mono w-36 focus:outline-none focus:border-emerald-500">
                </div>
                <div>
                    <label class="text-[10px] text-slate-500 uppercase block mb-1">Employer Match</label>
                    <input type="number" step="0.01" min="0" x-model.number="newEmployer" placeholder="0.00" class="bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm text-emerald-400 font-mono w-36 focus:outline-none focus:border-emerald-500">
                </div>
                <button @click="addContribution()" class="bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold px-5 py-2.5 rounded-lg transition shadow-lg shadow-emerald-950/55 h-[38px]">Add & Allocate</button>
                <p class="text-[11px] text-emerald-400 ml-auto" x-show="lastAllocationNote" x-text="lastAllocationNote"></p>
            </div>

            <div x-show="editingAllocation" class="flex justify-between text-[10px] text-slate-500 uppercase px-1 pt-1">
                <span>Your Target % totals: <span :class="Math.abs(mineTargetSum() - 100) < 0.5 ? 'text-emerald-400' : 'text-rose-400'" x-text="mineTargetSum().toFixed(1) + '%'"></span></span>
                <span>Employer Target % totals: <span :class="Math.abs(employerTargetSum() - 100) < 0.5 ? 'text-emerald-400' : 'text-rose-400'" x-text="employerTargetSum().toFixed(1) + '%'"></span></span>
            </div>
        </div>

        <!-- Holdings by Category -->
        <div class="bg-slate-900 rounded-xl border border-slate-800 overflow-hidden">
            <template x-for="cat in categories" :key="cat.name">
                <div class="border-b border-slate-800 last:border-b-0">
                    <div class="bg-slate-950/60 px-5 py-2.5">
